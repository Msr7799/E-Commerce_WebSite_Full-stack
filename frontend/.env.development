# Environment Configuration

# Application Settings
VITE_APP_NAME=E-Commerce Store
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=متجر إلكتروني متطور

# API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_API_TIMEOUT=10000

# Stripe Configuration (Replace with your actual keys)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CHAT_SUPPORT=false
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_MULTI_LANGUAGE=false

# Development Settings
VITE_DEV_TOOLS=true
VITE_LOG_LEVEL=debug

# Performance Settings
VITE_ENABLE_CODE_SPLITTING=true
VITE_ENABLE_LAZY_LOADING=true
VITE_CHUNK_SIZE_WARNING_LIMIT=500

# Security Settings
VITE_ENABLE_CSP=true
VITE_SECURE_COOKIES=false

# Cache Settings
VITE_CACHE_DURATION=300000
VITE_ENABLE_SERVICE_WORKER=true

# UI Settings
VITE_DEFAULT_LANGUAGE=ar
VITE_DEFAULT_CURRENCY=USD
VITE_ITEMS_PER_PAGE=12

# Social Media (Optional)
VITE_FACEBOOK_URL=
VITE_TWITTER_URL=
VITE_INSTAGRAM_URL=

# Contact Information
VITE_SUPPORT_EMAIL=support@example.com
VITE_SUPPORT_PHONE=+1234567890

# SEO Settings
VITE_SITE_URL=http://localhost:5173
VITE_SEO_TITLE=E-Commerce Store - أفضل متجر إلكتروني
VITE_SEO_DESCRIPTION=متجر إلكتروني شامل لجميع احتياجاتك مع أفضل الأسعار وخدمة العملاء

# Error Reporting (for production)
VITE_SENTRY_DSN=
VITE_ERROR_REPORTING_ENABLED=false

# Payment Gateway Settings
VITE_PAYMENT_CURRENCY=USD
VITE_MIN_ORDER_AMOUNT=1
VITE_MAX_ORDER_AMOUNT=10000

# Image Upload Settings
VITE_MAX_IMAGE_SIZE=5242880
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Rate Limiting (Frontend)
VITE_API_RATE_LIMIT=60
VITE_SEARCH_RATE_LIMIT=10
