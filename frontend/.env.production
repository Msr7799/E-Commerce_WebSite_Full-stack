# Production Environment Configuration

# Application Settings
VITE_APP_NAME=E-Commerce Store
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=متجر إلكتروني متطور

# API Configuration (Update with your production API URL)
VITE_API_URL=https://your-api-domain.com/api
VITE_API_TIMEOUT=15000

# Stripe Configuration (Use your live keys in production)
VITE_STRIPE_PUBLIC_KEY=pk_live_your_stripe_live_public_key_here

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CHAT_SUPPORT=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_MULTI_LANGUAGE=true

# Development Settings (Disabled in production)
VITE_DEV_TOOLS=false
VITE_LOG_LEVEL=error

# Performance Settings
VITE_ENABLE_CODE_SPLITTING=true
VITE_ENABLE_LAZY_LOADING=true
VITE_CHUNK_SIZE_WARNING_LIMIT=500

# Security Settings
VITE_ENABLE_CSP=true
VITE_SECURE_COOKIES=true

# Cache Settings
VITE_CACHE_DURATION=600000
VITE_ENABLE_SERVICE_WORKER=true

# UI Settings
VITE_DEFAULT_LANGUAGE=ar
VITE_DEFAULT_CURRENCY=USD
VITE_ITEMS_PER_PAGE=12

# Social Media
VITE_FACEBOOK_URL=https://facebook.com/yourstore
VITE_TWITTER_URL=https://twitter.com/yourstore
VITE_INSTAGRAM_URL=https://instagram.com/yourstore

# Contact Information
VITE_SUPPORT_EMAIL=support@yourdomain.com
VITE_SUPPORT_PHONE=+1234567890

# SEO Settings
VITE_SITE_URL=https://yourdomain.com
VITE_SEO_TITLE=E-Commerce Store - أفضل متجر إلكتروني
VITE_SEO_DESCRIPTION=متجر إلكتروني شامل لجميع احتياجاتك مع أفضل الأسعار وخدمة العملاء

# Error Reporting
VITE_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id
VITE_ERROR_REPORTING_ENABLED=true

# Payment Gateway Settings
VITE_PAYMENT_CURRENCY=USD
VITE_MIN_ORDER_AMOUNT=1
VITE_MAX_ORDER_AMOUNT=10000

# Image Upload Settings
VITE_MAX_IMAGE_SIZE=5242880
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Rate Limiting (Frontend)
VITE_API_RATE_LIMIT=60
VITE_SEARCH_RATE_LIMIT=10
